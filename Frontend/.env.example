# Public frontend configuration only. Never put secrets (Gemini/OpenWeather keys,
# tokens, database credentials) in this file — anything here ships to the browser.
#
# Leave VITE_API_BASE_URL EMPTY to talk to the API on the same origin.
#   - In development `npm run dev` proxies /users, /clothes and /images to the
#     FastAPI server (see vite.config.ts).
#   - In production serve the built `dist/` folder and the API from one origin.
# Same-origin matters: the backend sets its auth cookies with `SameSite=Lax`, so
# they are only sent on same-site requests.
VITE_API_BASE_URL=

# Where the Vite dev server proxies API requests (development only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
